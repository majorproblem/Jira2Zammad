# Copy this file to .env and fill in your values. Never commit .env.

# --- Jira (source) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
# "basic" (Cloud: email + API token) or "bearer" (Server/Data Center Personal Access Token)
JIRA_AUTH_TYPE=basic

# --- Zammad (destination) ---
ZAMMAD_BASE_URL=https://zammad.example.com
ZAMMAD_API_TOKEN=
ZAMMAD_GROUP=Users
